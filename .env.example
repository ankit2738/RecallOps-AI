# Application LLM (optional). Without a valid key RecallOps uses its labelled deterministic fallback.
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Hindsight local server. The API key is optional for a local Docker deployment.
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=recallops-incidents

# Existing Band agents (optional). RecallOps verifies these identities and never creates agents.
BAND_API_KEY=
BAND_TOM_API_KEY=
BAND_JERRY_API_KEY=
BAND_TOM_AGENT_ID=
BAND_JERRY_AGENT_ID=
BAND_CHAT_ID=
BAND_API_URL=

# Set false to skip the resolved-incident backfill on startup.
RECALLOPS_AUTO_SYNC=true
